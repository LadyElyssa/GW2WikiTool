<Window x:Class="GW2WikiTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GW2 Wiki Tool"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>

        <SolidColorBrush x:Key="GoldLight" Color="#F2D98A"/>
        <SolidColorBrush x:Key="GoldMid" Color="#D4AF37"/>
        <SolidColorBrush x:Key="GoldDark" Color="#8B6914"/>
        <SolidColorBrush x:Key="TextLight" Color="#E8DCC0"/>
        <SolidColorBrush x:Key="TextGray" Color="#8A8378"/>
        <SolidColorBrush x:Key="RowDivider" Color="#332A1C"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#120D08"/>
        <SolidColorBrush x:Key="FieldBackground" Color="#120D08"/>

        <LinearGradientBrush x:Key="CardFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1C1712" Offset="0"/>
            <GradientStop Color="#0C0906" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GoldBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F2D98A" Offset="0"/>
            <GradientStop Color="#B8862E" Offset="0.5"/>
            <GradientStop Color="#8B6914" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GoldTextBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5E4A8" Offset="0"/>
            <GradientStop Color="#C9A038" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2A2116" Offset="0"/>
            <GradientStop Color="#15100A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonFillHover" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3A2E1D" Offset="0"/>
            <GradientStop Color="#201808" Offset="1"/>
        </LinearGradientBrush>

        <DataTemplate x:Key="CopyIconTemplate">
            <Canvas Width="16" Height="16" Margin="0,0,4,0">
                <Rectangle Width="12" Height="12" Canvas.Left="-1" Canvas.Top="4"
                           Stroke="{StaticResource GoldTextBrush}" StrokeThickness="1.25"
                           RadiusX="1" RadiusY="1"/>
                <Rectangle Width="12" Height="12" Canvas.Left="3" Canvas.Top="0"
                           Stroke="{StaticResource GoldTextBrush}" StrokeThickness="1.25"
                           RadiusX="1" RadiusY="1" Fill="{StaticResource ButtonFill}"/>
            </Canvas>
        </DataTemplate>

        <DataTemplate x:Key="SearchIconTemplate">
            <Canvas Width="16" Height="16" Margin="0,0,5,0">
                <Ellipse Width="12" Height="12" Canvas.Left="0" Canvas.Top="0"
                         Stroke="{StaticResource GoldTextBrush}" StrokeThickness="1.5"/>
                <Line X1="10" Y1="10" X2="16" Y2="16" Stroke="{StaticResource GoldTextBrush}"
                      StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
        </DataTemplate>

        <Style x:Key="OrnateButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource GoldTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{StaticResource ButtonFill}"
                                BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="4,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ButtonFillHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ButtonBackground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="CaretBrush" Value="{StaticResource GoldMid}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="FieldTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.Effect>
            <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="0" Opacity="0.5"/>
        </Grid.Effect>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="{StaticResource CardFill}" CornerRadius="8"/>

        <Border Grid.Row="0" Background="{StaticResource FieldBackground}"
                BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="0,0,0,1"
                CornerRadius="8,8,0,0"/>

        <Grid x:Name="TitleBarGrid" Grid.Row="0" Margin="14,8,14,8"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Canvas Grid.Column="0" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse Width="20" Height="20" Canvas.Left="1" Canvas.Top="1"
                         Stroke="{StaticResource GoldMid}" StrokeThickness="1"/>
                <Path Data="M11,2 L13,11 L11,20 L9,11 Z" Fill="{StaticResource GoldMid}" Opacity="0.85"/>
                <Path Data="M2,11 L11,9 L20,11 L11,13 Z" Fill="{StaticResource GoldDark}" Opacity="0.85"/>
                <Ellipse Width="3" Height="3" Canvas.Left="9.5" Canvas.Top="9.5" Fill="{StaticResource GoldLight}"/>
            </Canvas>

            <TextBlock Grid.Column="1" Text="G W 2   W I K I   T O O L"
                       FontFamily="Cambria" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource GoldTextBrush}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="2" Click="Close_Click" Cursor="Hand" ToolTip="Close"
                    AutomationProperties.Name="Close"
                    Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center" Padding="4">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="&#x2715;" Foreground="{TemplateBinding Foreground}" FontSize="12"/>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Foreground" Value="{StaticResource TextGray}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource GoldTextBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="14,8,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition MinWidth="200" Width="*"/>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Current Location" Foreground="{StaticResource TextLight}" FontSize="12"/>
                    <TextBlock Text="(Wiki Coordinates)" Foreground="{StaticResource TextGray}" FontSize="10"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource FieldBackground}"
                        BorderBrush="{StaticResource GoldDark}" BorderThickness="1" CornerRadius="4"
                        Margin="0,0,6,0" Height="30">
                    <TextBlock x:Name="LocationValueText" Style="{StaticResource FieldTextBlockStyle}"
                               Text="Waiting for game..." Margin="8,0"/>
                </Border>

                <Button x:Name="CopyLocationButton" Grid.Column="3" Style="{StaticResource OrnateButtonStyle}"
                        Click="CopyLocation_Click" AutomationProperties.Name="Copy Location">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter ContentTemplate="{StaticResource CopyIconTemplate}"/>
                        <TextBlock x:Name="CopyLocationButtonText" Text="COPY"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource RowDivider}" Margin="0,3,0,3"/>

            <Grid Grid.Row="2" Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition MinWidth="200" Width="*"/>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Achievement ID" Foreground="{StaticResource TextLight}"
                           FontSize="12" VerticalAlignment="Center"/>

                <Border Grid.Column="1" Background="{StaticResource FieldBackground}"
                        BorderBrush="{StaticResource GoldDark}" BorderThickness="1" CornerRadius="4"
                        Margin="0,0,6,0" Height="30">
                    <Grid>
                        <TextBox x:Name="AchievementBox" Style="{StaticResource FieldTextBoxStyle}"
                                 Margin="8,0" TextChanged="AchievementBox_TextChanged"
                                 KeyDown="AchievementBox_KeyDown"
                                 AutomationProperties.Name="Achievement Search"/>
                        <TextBlock x:Name="AchievementHint" Text="Search achievement..."
                                   Foreground="{StaticResource TextGray}" FontSize="12"
                                   Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Button x:Name="SearchAchievementButton" Grid.Column="2" Style="{StaticResource OrnateButtonStyle}"
                        Margin="0,0,6,0" Click="SearchAchievement_Click"
                        AutomationProperties.Name="Search Achievement">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter ContentTemplate="{StaticResource SearchIconTemplate}"/>
                        <TextBlock Text="SEARCH"/>
                    </StackPanel>
                </Button>

                <Button x:Name="CopyAchievementButton" Grid.Column="3" Style="{StaticResource OrnateButtonStyle}"
                        Click="CopyAchievement_Click" AutomationProperties.Name="Copy Achievement">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter ContentTemplate="{StaticResource CopyIconTemplate}"/>
                        <TextBlock x:Name="CopyAchievementButtonText" Text="COPY"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource RowDivider}" Margin="0,3,0,3"/>

            <Grid Grid.Row="4" Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition MinWidth="200" Width="*"/>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Waypoint" Foreground="{StaticResource TextLight}"
                           FontSize="12" VerticalAlignment="Center"/>

                <Border Grid.Column="1" Background="{StaticResource FieldBackground}"
                        BorderBrush="{StaticResource GoldDark}" BorderThickness="1" CornerRadius="4"
                        Margin="0,0,6,0" Height="30">
                    <Grid>
                        <TextBox x:Name="WaypointBox" Style="{StaticResource FieldTextBoxStyle}"
                                 Margin="8,0" TextChanged="WaypointBox_TextChanged"
                                 KeyDown="WaypointBox_KeyDown"
                                 AutomationProperties.Name="Waypoint Search"/>
                        <TextBlock x:Name="WaypointHint" Text="Search waypoint..."
                                   Foreground="{StaticResource TextGray}" FontSize="12"
                                   Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Button x:Name="SearchWaypointButton" Grid.Column="2" Style="{StaticResource OrnateButtonStyle}"
                        Margin="0,0,6,0" Click="SearchWaypoint_Click"
                        AutomationProperties.Name="Search Waypoint">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter ContentTemplate="{StaticResource SearchIconTemplate}"/>
                        <TextBlock Text="SEARCH"/>
                    </StackPanel>
                </Button>

                <Button x:Name="CopyWaypointButton" Grid.Column="3" Style="{StaticResource OrnateButtonStyle}"
                        Click="CopyWaypoint_Click" AutomationProperties.Name="Copy Waypoint">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter ContentTemplate="{StaticResource CopyIconTemplate}"/>
                        <TextBlock x:Name="CopyWaypointButtonText" Text="COPY"/>
                    </StackPanel>
                </Button>
            </Grid>

        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.Row="0" Height="1" Fill="{StaticResource GoldBorderBrush}" Margin="0,3,0,0"/>

            <Grid Grid.Row="1" Margin="14,10,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusIcon" Grid.Column="0" Text="&#x25CF;" Foreground="#5CBB6A"
                           FontSize="18 " VerticalAlignment="Center" Margin="0,-2,6,0"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Waiting for game..." Foreground="{StaticResource TextLight}"
                           FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="LastUpdatedSeparator" Grid.Column="2" Text="   |   " Foreground="{StaticResource TextGray}"
                           FontSize="13" VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="LastUpdatedText" Grid.Column="3" Text="Last updated: —" Foreground="{StaticResource TextGray}"
                           FontSize="13" VerticalAlignment="Center" Visibility="Collapsed"/>

                <Button x:Name="RetryButton" Grid.Column="4" Style="{StaticResource OrnateButtonStyle}"
                        Margin="10,0,0,0" HorizontalAlignment="Right" Click="Retry_Click" 
                        ToolTip="Retry fetching achievement/waypoint data"
                        AutomationProperties.Name="Retry">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x21BB;" Margin="0,-4,4,0" FontSize="22" VerticalAlignment="Center"/>
                        <TextBlock Text="RETRY" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>